aikkakunta":{"koodiUri":"kunta_405","nimi":{"fi":"Lappeenranta","sv":"Villmanstrand"}},"nimi":{"fi":"Lappeenrannan-Lahden teknillinen yliopisto LUT","sv":"Lappeenrannan-Lahden teknillinen yliopisto LUT","en":"Lappeenranta-Lahti University of Technology LUT"},"oid":"1.2.246.562.10.42777795784"},"metadata":{"kuvaus":{"en":"<p>Your studies in this programme will focus on theoretical knowledge and technical skills in relevant business analytics methods, including data analytics, modelling, simulation, and multiple-criteria decision-making and evaluation methods and their practical use on real-world data in a real-world business or industry context. The software and tools applied during the course are standard in the industry.</p><p>The need for analytics is growing due to the abundance of data available. Business analytics includes quantitative and statistical analysis, machine learning, multivariate testing, predictive modelling, and multiple-criteria evaluation and decision support. It uses data to evaluate past performances and to draw up plans for the future. As a graduate from this programme, you will be in high demand and have access to interesting positions in business and industry.</p>"},"osaamistavoitteet":{},"isMuokkaajaOphVirkailija":false,"ammattinimikkeet":[{"kieli":"en","arvo":"business analyst"},{"kieli":"en","arvo":"business development specialist"},{"kieli":"en","arvo":"business development manager"},{"kieli":"en","arvo":"business controller"}],"asiasanat":[{"kieli":"en","arvo":"business analytics"},{"kieli":"en","arvo":"statistical analysis"},{"kieli":"en","arvo":"data analytics"},{"kieli":"en","arvo":"modelling"},{"kieli":"en","arvo":"simulation"}],"isTyovoimakoulutus":false,"hasJotpaRahoitus":false,"isTaydennyskoulutus":false,"opetus":{"apuraha":{"min":5000,"max":5000,"yksikko":"euro","kuvaus":{"en":"<p>All tuition fee–paying students are automatically awarded a <strong>LUT scholarship of EUR 5,000 for the second academic year,</strong> provided they complete <strong>at least 60 ECTS credits</strong> in their personal study plan <strong>during the first academic year.</strong><br><a href=\"https://https://www.lut.fi/en/studies/apply-lut/applying-masters-programmes/early-bird-discount-and-scholarships-masters-studies\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"https://https//www.lut.fi/en/studies/apply-lut/applying-masters-programmes/early-bird-discount-and-scholarships-masters-studies\">Discounts for master's studies</a></p>"}},"maksullisuusKuvaus":{"en":"<p>If you are required to pay tuition fees, you will receive&nbsp;<strong>an Early bird discount of EUR 5,000 for the first academic year. </strong>To qualify, you must accept your study place and pay the remaining first-year tuition fee of EUR 10,000&nbsp;<strong>within 21 days of your official admission email.</strong><br><a href=\"https://https://www.lut.fi/en/studies/apply-lut/applying-masters-programmes/early-bird-discount-and-scholarships-masters-studies\" target=\"_blank\" rel=\"noopener noreferrer\" title=\"https://https//www.lut.fi/en/studies/apply-lut/applying-masters-programmes/early-bird-discount-and-scholarships-masters-studies\">Discounts for master's studies</a></p>"},"suunniteltuKestoKuvaus":{},"suunniteltuKestoVuodet":2,"onkoApuraha":true,"lisatiedot":[],"maksut":[{"maksullisuustyyppi":"lukuvuosimaksu","maksunMaara":15000.0}],"suunniteltuKestoKuukaudet":0,"opetustapaKuvaus":{},"opetuskieletKuvaus":{},"opetustapa":[{"koodiUri":"opetuspaikkakk_1#1","nimi":{"fi":"Lähiopetus","sv":"Närundervisning","en":"Contact teaching"}}],"opetusaikaKuvaus":{},"opetuskieli":[{"koodiUri":"oppilaitoksenopetuskieli_4#2","nimi":{"fi":"englanti","sv":"engelska","en":"English"}}],"opetusaika":[{"koodiUri":"opetusaikakk_1#1","nimi":{"fi":"Päiväopetus","sv":"Dagundervisning","en":"Day time teaching"}}]},"yhteyshenkilot":[{"nimi":{"en":"LUT University "},"titteli":{"en":"Admissions Services"},"sahkoposti":{"en":"admission@lut.fi"},"puhelinnumero":{},"wwwSivu